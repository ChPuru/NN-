    {
      "name": "machine noise floor",
      "claim": "n/a -- calibration, not a published claim",
      "measured": "median/min 1.20x, max/min 2.27x over 30 runs of a bit-identical 512x512 f32 matmul",
      "verdict": "MEASURED"
    },
    {
      "name": "float32 vs float64 matmul",
      "claim": "~1.5-2x, not the 7.5x a popular microbenchmark reports (that one is dominated by writing a 400 MB smaller output matrix)",
      "measured": "2.32x on minima, 1.90x on medians (1024x1024 GEMM, 1 thread(s))",
      "verdict": "CONFIRMED"
    },
    {
      "name": "einsum optimize=True",
      "claim": "the default optimize=False never dispatches to BLAS -- a 30-300x loss",
      "measured": "33.8x on minima, 37.7x on medians ('nch,co->noh', x=(32,64,100) f32, w=(64,128) f32)",
      "verdict": "CONFIRMED"
    },
    {
      "name": "NumPy per-call dispatch overhead",
      "claim": "under 1% only above ~1e5-1e6 elements per call, not 1e4",
      "measured": "n = 99*c0/t_e = 57,550 elements from c0=0.579 us/call and t_e=0.996 ns/elem; at n=1e4 the model says 5% overhead, measured 21% at n=8,192; first measured row under 1% at n=1,048,576",
      "verdict": "DIFFERENT-ON-THIS-MACHINE"
    }
